# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real keys.

# Get these from https://turso.tech after creating a free database.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Featherless AI (agent inference) ----
# Serverless open-model inference, OpenAI-compatible.
# Get a key at https://featherless.ai
FEATHERLESS_API_KEY=your-featherless-key

# Any model id from the Featherless catalog. This one is a plain instruct
# model - no "thinking" step - and measured ~2-4s per prediction, which
# fits inside Vercel's default 10s function timeout.
#
# Reasoning models (DeepSeek-R1 distills, QwQ, etc.) "think" before
# answering and are much slower - the R1-14B distill measured ~19-34s,
# QwQ-32B ~40s. That will time out as a Vercel serverless function unless
# you migrate vercel.json off the legacy builds/routes format to set a
# longer maxDuration. Only use one if you've made that change.
FEATHERLESS_MODEL=Qwen/Qwen2.5-14B-Instruct

# Optional overrides.
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_TIMEOUT=90
