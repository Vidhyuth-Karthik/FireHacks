# Copy this file to .env and fill in your own values.
# Get these from https://turso.tech after creating a free database.

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Text to speech (self-hosted Kokoro FastAPI) ----
# Base URL of the Kokoro server, including the /v1 suffix.
# Local Docker default:
TTS_BASE_URL=http://localhost:8880/v1
# If you run this API itself in Docker Compose alongside Kokoro, use the
# service name instead: http://kokoro:8880/v1

# Optional - these all have sensible defaults, listed here for reference.
# TTS_MODEL=kokoro
# TTS_DEFAULT_VOICE=af_heart
# TTS_RESPONSE_FORMAT=mp3
# TTS_MAX_CHARS=2000
# TTS_TIMEOUT_SECONDS=60
# TTS_RATE_LIMIT_REQUESTS=20
# TTS_RATE_LIMIT_WINDOW_SECONDS=60
