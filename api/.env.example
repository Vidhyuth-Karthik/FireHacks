# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real keys.

# Get these from https://turso.tech after creating a free database.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Azure OpenAI (agent inference) ----
# Get these from your Azure AI Foundry resource.
AZURE_OPENAI_API_KEY=your-azure-openai-key

# Full URL to the v1 Responses endpoint for your resource, e.g.
# https://your-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/responses

# Your deployment name (not the base model id), e.g. "gpt-4o-mini".
# A plain instruct deployment - no "thinking" step - measures ~2-4s per
# prediction, which fits inside Vercel's default 10s function timeout.
#
# A reasoning deployment (o1, o3-mini, etc.) "thinks" before answering
# and is much slower - likely 20-40s+. That will time out as a Vercel
# serverless function unless you migrate vercel.json off the legacy
# builds/routes format to set a longer maxDuration. Only use one if
# you've made that change.
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional override.
# AZURE_OPENAI_TIMEOUT=90
