# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real keys.

# Get these from https://turso.tech after creating a free database.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- Featherless AI (agent inference) ----
# Serverless open-model inference, OpenAI-compatible.
# Get a key at https://featherless.ai
FEATHERLESS_API_KEY=your-featherless-key

# Any model id from the Featherless catalog.
# Reasoning models think before answering and are SLOW - the R1 distill
# below measured ~19s per prediction, QwQ-32B ~40s. That is workable for
# /predict (the frontend prefetches it) but not for anything on the
# press-to-speak path. Swap to a non-reasoning instruct model if you want
# a snappier demo.
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-14B

# Optional overrides.
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_TIMEOUT=90
